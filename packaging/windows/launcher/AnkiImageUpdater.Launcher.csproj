<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>AnkiImageUpdater</RootNamespace>
    <AssemblyName>AnkiImageUpdater</AssemblyName>
    <ApplicationIcon>..\AppIcon.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Self-contained single-file settings live in Properties/PublishProfiles/WinX64SelfContained.pubxml
         so `dotnet publish` is not forced framework-dependent by .NET 8's RID defaults. -->
  </PropertyGroup>

  <!-- PyApp binary is copied to Embedded/ immediately before `dotnet publish` (see CI / build_binary.sh). -->
  <ItemGroup Condition="Exists('Embedded\\AnkiImageUpdaterPyApp.exe')">
    <EmbeddedResource Include="Embedded\AnkiImageUpdaterPyApp.exe" LogicalName="AnkiImageUpdaterPyApp.exe" />
  </ItemGroup>

  <Target Name="EnsureEmbeddedPyApp" BeforeTargets="Publish">
    <Error
      Condition="!Exists('Embedded\\AnkiImageUpdaterPyApp.exe')"
      Text="Copy dist-bin/bin/AnkiImageUpdaterPyApp.exe to packaging/windows/launcher/Embedded/ before dotnet publish." />
  </Target>
</Project>
